{
  "name": "keel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-barcode-decoder.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:next": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:crypto": "node src/lib/crypto/crypto.verify.mjs",
    "test:vault": "node src/lib/db/vault.verify.mjs",
    "test:site": "node --test tests/sites-worker.verify.mjs",
    "test:service-worker": "node scripts/service-worker.verify.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "audit:privacy": "node scripts/privacy-audit.mjs",
    "audit:public-data": "node scripts/public-data-audit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:crypto && npm run test:vault && npm run build && npm run test:site && npm run test:service-worker && npm run audit:privacy && npm run audit:public-data && npm run audit:dependencies"
  },
  "dependencies": {
    "barcode-detector": "3.2.1",
    "dexie": "^4.4.4",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "$sharp"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-linux-64": "1.20260722.1",
    "@esbuild/linux-x64": "0.28.1",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@next/swc-linux-x64-gnu": "16.2.12",
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
